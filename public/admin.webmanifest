{
  "id": "/admin",
  "name": "Portfolio Admin",
  "short_name": "Admin",
  "description": "Edit your portfolio: posts, projects, skills and settings.",
  "start_url": "/admin",
  "scope": "/admin",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b1020",
  "theme_color": "#0b1020",
  "icons": [
    {
      "src": "/admin-icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/admin-icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/admin-icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/admin-icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New post",
      "short_name": "New post",
      "description": "Start writing a new blog post",
      "url": "/admin?action=new-post#posts",
      "icons": [
        {
          "src": "/admin-icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Site health",
      "short_name": "Health",
      "description": "See whether your sites are up",
      "url": "/admin?focus=health#overview",
      "icons": [
        {
          "src": "/admin-icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Site settings",
      "short_name": "Settings",
      "description": "Edit your details, links and SEO",
      "url": "/admin#settings",
      "icons": [
        {
          "src": "/admin-icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/admin/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
