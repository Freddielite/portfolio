# Env vars for the custom /admin panel. Set these in Vercel -> your project
# -> Settings -> Environment Variables (not in a committed .env file), then
# redeploy once. See README.md "Admin panel" section for full setup steps.

# The password you type in at /admin. There's no username, just this one
# password, so pick something you don't reuse anywhere else.
ADMIN_PASSWORD=

# A long random string used to sign the admin login session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# A GitHub fine-grained personal access token, scoped ONLY to this repo,
# with Contents: Read and write permission. The admin panel uses it to
# commit your edits straight to the repo, which is what makes Vercel
# redeploy automatically. See README.md for how to create one.
GITHUB_TOKEN=

# The repo the admin panel commits to, e.g. for github.com/yourname/portfolio:
GITHUB_OWNER=yourname
GITHUB_REPO=portfolio
GITHUB_BRANCH=main

# Newsletter (optional). Powers the Subscribers tab in /admin and the
# "Send to subscribers" button. All three come from your Wynmail app.
# Your Wynmail backend address, for example https://wynmail-api.onrender.com
WYNMAIL_API_URL=
# A workspace API key from Wynmail's API page (starts with wm_). Keep it secret.
WYNMAIL_API_KEY=
# The number of the list that holds your subscribers (GET /v1/lists shows it).
WYNMAIL_LIST_ID=
