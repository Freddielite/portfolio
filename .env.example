# Copy this file to .env and fill in once you've created a free Sanity
# project (see /studio/README.md). Until these are set, the site runs
# entirely on the fallback content in src/data/ — nothing breaks.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Only needed to run `npm run seed` (imports your existing content into
# Sanity). See studio/README.md "Importing your existing content" for how
# to create this token. Never commit this file or share this value.
SANITY_API_TOKEN=
